<%- include("../../partials/header.ejs") %>
<%- include("../../partials/navbar.ejs") %>
<style>
    input.error, select.error {
        border: 2px solid #e74c3c !important;
        background-color: #fdecea !important;
    }

    .alert-danger {
        background-color: #f8d7da;
        color: #721c24;
        border: 1px solid #f5c2c7;
        border-radius: 6px;
        padding: 10px;
    }
</style>
<div class="container">
    <hr>
    <div class="card">
        <div class="card-header">
            <h2>Atualizar Peça</h2>
        </div>
        <div class="card-body">
            <form method="POST" action="/parts/update">
                <!-- Nome -->
                <label>Nome:</label>
                <input class="form-control" type="text" name="name" placeholder="Defina o nome para a peça" value="<%= part.name %>"><br>

                <!-- Fornecedor -->
                <label>Fornecedor:</label>
                <input class="form-control" type="text" name="seller" placeholder="Defina o nome do fornecedor" value="<%= part.seller %>"><br>

                <!-- Valor -->
                <label>Valor R$:</label>
                <input class="form-control" type="number" step="0.01" name="value" placeholder="0000,00" value="<%= part.value.toFixed(2) %>"><br>

                <!-- Tipo de peça -->
                <label style="padding-right: 22px;">Tipo de peça:</label><br>
                <select name="type" id="type" class="form-control-sm">
                    <% types.forEach((type) => { %>
                        <option value="<%= type.id %>" <%= part.typeId == type.id ? "selected" : "" %>><%= type.name %></option>
                    <% }) %>
                    <option value="novo">Adicionar um novo</option>
                </select>
                <div id="newType" style="display:none;padding-top:10px">
                    <input type="text" class="form-control-sm" name="newType" placeholder="Digite o novo tipo">
                </div>
                <br><br>

                <!-- Compatibilidades -->
                <label>Compatibilidade:</label><br>
                <div id="compatibilityContainer">
                    <% if (part.compatibilities && part.compatibilities.length > 0) { %>
                        <% part.compatibilities.forEach((selectedComp) => { %>
                            <div class="compatibilityItem d-flex align-items-center mb-2">
                                <select name="compatibility[]" class="form-control-sm compatibilitySelect me-2">
                                    <option value="" disabled>Marca</option>
                                    <% compatibilities.forEach((comp) => { %>
                                        <option value="<%= comp.id %>" <%= comp.id === selectedComp.id ? "selected" : "" %>><%= comp.name %></option>
                                    <% }); %>
                                    <option value="novo">Adicionar um novo</option>
                                </select>
                                <div class="newCompatibility" style="display:none;padding-top:0;">
                                    <input type="text" class="form-control-sm" name="newCompatibility[]" placeholder="Digite a nova marca">
                                </div>
                                <button type="button" class="btn btn-danger btn-sm ms-2 removeCompatibility">×</button>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="compatibilityItem d-flex align-items-center mb-2">
                            <select name="compatibility[]" class="form-control-sm compatibilitySelect me-2">
                                <option value="" disabled selected>Marca</option>
                                <% compatibilities.forEach((comp) => { %>
                                    <option value="<%= comp.id %>"><%= comp.name %></option>
                                <% }); %>
                                <option value="novo">Adicionar um novo</option>
                            </select>
                            <div class="newCompatibility" style="display:none;padding-top:0;">
                                <input type="text" class="form-control-sm" name="newCompatibility[]" placeholder="Digite a nova marca">
                            </div>
                            <button type="button" class="btn btn-danger btn-sm ms-2 removeCompatibility">×</button>
                        </div>
                    <% } %>
                </div>
                <button type="button" class="btn btn-secondary btn-sm mt-2" id="addCompatibility">+ Adicionar outra marca</button>
                <br><br>

                <input type="hidden" name="id" value="<%= part.id %>">
                <button class="btn btn-success">Atualizar</button>
            </form>
        </div>
    </div>
</div>

<script>
        document.querySelector('form[action="/parts/update"]').addEventListener("submit", function(event) {
    event.preventDefault();

    let valid = true;
    let messages = [];

    // Limpa erros anteriores
    document.querySelectorAll(".error").forEach(el => el.classList.remove("error"));
    const oldAlert = document.getElementById("formAlert");
    if (oldAlert) oldAlert.remove();

    // Cria alerta
    const alert = document.createElement("div");
    alert.id = "formAlert";
    alert.className = "alert alert-danger mt-2";
    alert.style.display = "none";

    // Campos principais obrigatórios
    const fields = [
        { name: "name", label: "Nome" },
        { name: "seller", label: "Fornecedor" },
        { name: "value", label: "Valor" },
        { name: "type", label: "Tipo de peça" }
    ];

    fields.forEach(field => {
        const input = document.querySelector(`[name="${field.name}"]`);
        if (input) {
        const value = input.value.trim();
        if (!value) {
            valid = false;
            messages.push(`O campo "${field.label}" é obrigatório.`);
            input.classList.add("error");
        }
        }
    });

    // --- Verifica o campo "Tipo de peça" ---
    const typeSelect = document.querySelector('[name="type"]');
    const newTypeInput = document.querySelector('[name="newType"]');
    if (typeSelect && typeSelect.value === "novo") {
        if (!newTypeInput.value.trim()) {
        valid = false;
        messages.push('Digite o nome do novo tipo de peça.');
        newTypeInput.classList.add("error");
        }
    }

    // --- Verifica compatibilidades ---
    const compatItems = document.querySelectorAll('.compatibilityItem');
    compatItems.forEach(item => {
        const select = item.querySelector('.compatibilitySelect');
        const newInput = item.querySelector('input[name="newCompatibility[]"]');

        // se o usuário não escolheu marca nenhuma
        if (select && select.value === "") {
        valid = false;
        select.classList.add("error");
        }

        // se ele escolheu "novo", mas não digitou o nome
        if (select && select.value === "novo") {
        if (!newInput.value.trim()) {
            valid = false;
            messages.push('Digite o nome da nova marca adicionada.');
            newInput.classList.add("error");
        }
        }
    });

    // Mostra alerta se houver erros
    if (!valid) {
        alert.innerHTML = "⚠️ Verifique os campos destacados antes de continuar.<br>" + messages.join("<br>");
        this.prepend(alert);
        alert.style.display = "block";
        return;
    }

    // Se tudo ok, envia
    this.submit();
    });
 
 // Mostrar/ocultar novo tipo
    document.getElementById('type').addEventListener('change', function() {
        document.getElementById('newType').style.display = this.value === 'novo' ? 'block' : 'none';
    });

    // Função para mostrar/ocultar campo "novo" para compatibilidade
    function attachCompatibilityHandler(selectElement) {
        const newCompDiv = selectElement.closest('.compatibilityItem').querySelector('.newCompatibility');
        selectElement.addEventListener('change', function () {
            newCompDiv.style.display = this.value === 'novo' ? 'block' : 'none';
        });
        // Executa no carregamento caso já seja "novo"
        if (selectElement.value === 'novo') {
            newCompDiv.style.display = 'block';
        }
    }

    // Função para remover uma compatibilidade
    function attachRemoveHandler(button) {
        button.addEventListener('click', function () {
            const container = document.getElementById('compatibilityContainer');
            const item = this.closest('.compatibilityItem');
            if (container.querySelectorAll('.compatibilityItem').length > 1) {
                item.remove();
            } else {
                // Se for o último, limpa campos
                item.querySelector('.compatibilitySelect').value = "";
                item.querySelector('.newCompatibility input').value = "";
                item.querySelector('.newCompatibility').style.display = 'none';
            }
        });
    }

    // Inicializa handlers para itens existentes
    document.querySelectorAll('.compatibilitySelect').forEach(attachCompatibilityHandler);
    document.querySelectorAll('.removeCompatibility').forEach(attachRemoveHandler);

    // Botão adicionar nova compatibilidade
    document.getElementById('addCompatibility').addEventListener('click', function () {
        const container = document.getElementById('compatibilityContainer');
        const template = container.querySelector('.compatibilityItem');
        const newItem = template.cloneNode(true);

        // Limpa valores
        newItem.querySelector('.compatibilitySelect').value = "";
        newItem.querySelector('.newCompatibility').style.display = 'none';
        newItem.querySelector('input').value = "";

        // Reaplica handlers
        attachCompatibilityHandler(newItem.querySelector('.compatibilitySelect'));
        attachRemoveHandler(newItem.querySelector('.removeCompatibility'));

        container.appendChild(newItem);
    });
</script>

<%- include("../../partials/footer.ejs") %>
